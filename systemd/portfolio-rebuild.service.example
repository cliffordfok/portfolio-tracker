[Unit]
Description=Rebuild Portfolio Tracker public snapshot

[Service]
Type=oneshot
User=portfolio
Group=portfolio
EnvironmentFile=/etc/portfolio-tracker/portfolio.env
WorkingDirectory=/opt/portfolio-tracker/backend
ExecStart=/usr/bin/python3 -m portfolio_tracker.cli --root ${PORTFOLIO_RUNTIME_ROOT} rebuild
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio-tracker

[Install]
WantedBy=multi-user.target
