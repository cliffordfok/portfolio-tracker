[Unit]
Description=Publish Portfolio Tracker snapshot to GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=portfolio
Group=portfolio
EnvironmentFile=/etc/portfolio-tracker/portfolio.env
WorkingDirectory=/opt/portfolio-tracker/backend
ExecStart=/usr/bin/python3 -m portfolio_tracker.cli --root ${PORTFOLIO_RUNTIME_ROOT} publish --repository ${PORTFOLIO_REPOSITORY} --branch ${PORTFOLIO_DATA_BRANCH} --path portfolio-snapshot.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio-tracker

[Install]
WantedBy=multi-user.target
