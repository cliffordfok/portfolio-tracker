[Unit]
Description=Back up Portfolio Tracker private ledgers

[Service]
Type=oneshot
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio-tracker/backend
ExecStart=/usr/bin/python3 -m portfolio_tracker.cli --root /var/lib/portfolio-tracker backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio-tracker
