# Copy to a private VPS location such as /etc/portfolio-tracker/portfolio.env.
# Never commit the real token.
PORTFOLIO_GITHUB_TOKEN=github_pat_REPLACE_ON_VPS
PORTFOLIO_REPOSITORY=YOUR_GITHUB_USERNAME/portfolio-tracker
PORTFOLIO_DATA_BRANCH=portfolio-data
PORTFOLIO_RUNTIME_ROOT=/var/lib/portfolio-tracker
PORTFOLIO_PROJECT_ROOT=/opt/portfolio-tracker
